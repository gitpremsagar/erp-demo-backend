# Copy to .env and fill in real values. Never commit .env or env.

DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/DB?retryWrites=true&w=majority"

PORT=3008
NODE_ENV=development

# Generate each with: openssl rand -base64 64  (MUST be unique per key)
ACCESS_TOKEN_JWT_SECRET=replace-with-unique-secret
REFRESH_TOKEN_JWT_SECRET=replace-with-unique-secret
CRON_SECRET=replace-with-unique-secret

ACCESS_TOKEN_JWT_EXPIRY=3600
REFRESH_TOKEN_JWT_EXPIRY=604800
BCRYPT_SALT_ROUNDS=10

# Production only — root domain for cookies, e.g. .srigopaltraders.com
COOKIE_DOMAIN=

# Optional comma-separated extra CORS origins (staging, etc.)
CORS_ORIGINS=

# ===== AI assistant (DeepSeek) =====
# Server-side only. Never expose this key to the frontend.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONER_MODEL=deepseek-v4-pro
# enabled | disabled. Keep disabled for tool-calling latency unless tools fail.
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=low
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=1500

AI_ENABLED=true
# Tool rounds are not capped. The total request deadline is the safety guard.
AI_REQUEST_TIMEOUT_MS=60000
AI_TOTAL_TIMEOUT_MS=180000
AI_TOOL_TIMEOUT_MS=30000
AI_RATE_LIMIT_WINDOW_MS=300000
AI_RATE_LIMIT_MAX=30
