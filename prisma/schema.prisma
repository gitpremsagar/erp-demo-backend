// ==========================PURCHASE CENTRIC MODELS=========================

model Purchase {
  id                      String    @id @default(auto()) @map("_id") @db.ObjectId
  purchaseDate            DateTime  @default(now())
  createdByUserId         String    @db.ObjectId
  CreatedByUser           User      @relation("PurchaseCreator", fields: [createdByUserId], references: [id])
  markedArrivedByUserId   String?   @db.ObjectId
  MarkedArrivedByUser     User?     @relation("PurchaseMarkedArrivedBy", fields: [markedArrivedByUserId], references: [id])
  markedArrivedAt         DateTime?
  markedUnloadingByUserId String?   @db.ObjectId
  MarkedUnloadingByUser   User?     @relation("PurchaseMarkedUnloadingBy", fields: [markedUnloadingByUserId], references: [id])
  markedUnloadingAt       DateTime?
  markedUnloadedAt        DateTime?
  markedCompletedAt       DateTime?
  markedUnloadedByUserId  String?   @db.ObjectId
  MarkedUnloadedByUser    User?     @relation("PurchaseMarkedUnloadedBy", fields: [markedUnloadedByUserId], references: [id])
  markedCompletedByUserId String?   @db.ObjectId
  MarkedCompletedByUser   User?     @relation("PurchaseMarkedCompletedBy", fields: [markedCompletedByUserId], references: [id])
  TargetUnloadingDate     DateTime?
  TargetUnloadingByUserId String?   @db.ObjectId
  TargetUnloadingByUser   User?     @relation("PurchaseTargetUnloadingBy", fields: [TargetUnloadingByUserId], references: [id])
  VehicleExitedAt         DateTime?
  stockAddedAt            DateTime?
  stockAddedByUserId      String?   @db.ObjectId
  StockAddedByUser        User?     @relation("PurchaseStockAddedBy", fields: [stockAddedByUserId], references: [id])

  transporterId           String                    @db.ObjectId
  vehicleNumber           String?
  driverContact           String?
  grnNumber               String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  purchaseTransportStatus PURCHASE_TRANSPORT_STATUS @default(PENDING)
  Transporter             Transporter               @relation(fields: [transporterId], references: [id])
  PurchaseInvoice         PurchaseInvoice[]
  stockBatches            StockBatch[]
  purchaseStockBatches    PurchaseStockBatch[]
}

model PurchaseStockBatch {
  id                      String                     @id @default(auto()) @map("_id") @db.ObjectId
  productId               String                     @db.ObjectId
  purchaseId              String                     @db.ObjectId
  manufacturingDate       DateTime
  arrivalDate             DateTime
  expiryDate              DateTime
  stockQuantity           Int                        @default(0)
  purchaseTransportStatus PURCHASE_TRANSPORT_STATUS? @default(PENDING)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  product                 Product                    @relation(fields: [productId], references: [id])
  Purchase                Purchase                   @relation(fields: [purchaseId], references: [id])

  @@index([productId])
  @@index([purchaseId])
  @@index([purchaseId, purchaseTransportStatus])
}

model Transporter {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  transporterContact String?
  area               String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  purchases          Purchase[]
}

enum PURCHASE_TRANSPORT_STATUS {
  PENDING
  LOADING
  LOADED
  IN_TRANSIT
  ARRIVED
  UNLOADING
  UNLOADED
  EXITED
  COMPLETED
}

model PurchaseInvoice {
  id                  String                @id @default(auto()) @map("_id") @db.ObjectId
  invoiceID           String?
  invoiceDate         DateTime?
  invoiceAmount       Float?
  purchaseId          String                @db.ObjectId
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  PurchaseInvoiceItem PurchaseInvoiceItem[]
  purchase            Purchase?             @relation(fields: [purchaseId], references: [id])
  StockBatch          StockBatch[]

  @@index([invoiceDate])
}

// ==========================PRODUCT ALLOCATION==========================

/// Admin allocation of a high-demand product across one or more stock batches.
model ProductAllocation {
  id              String                   @id @default(auto()) @map("_id") @db.ObjectId
  productId       String                   @db.ObjectId
  allocationDate  DateTime
  receivedQty     Int
  notes           String?
  createdByUserId String                   @db.ObjectId
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  Product         Product                  @relation(fields: [productId], references: [id])
  CreatedByUser   User                     @relation("ProductAllocationCreator", fields: [createdByUserId], references: [id])
  lines           ProductAllocationLine[]
  batches         ProductAllocationBatch[]

  @@index([productId])
  @@index([allocationDate])
}

/// Links an allocation to one stock batch (each batch may belong to at most one allocation).
model ProductAllocationBatch {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  allocationId  String            @db.ObjectId
  stockBatchId  String            @unique @db.ObjectId
  createdAt     DateTime          @default(now())
  allocation    ProductAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  stockBatch    StockBatch        @relation(fields: [stockBatchId], references: [id])

  @@index([allocationId])
}

model ProductAllocationLine {
  id            String                          @id @default(auto()) @map("_id") @db.ObjectId
  allocationId  String                          @db.ObjectId
  customerId    String                          @db.ObjectId
  allocatedQty  Int
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt
  allocation    ProductAllocation               @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  customer      User                            @relation(fields: [customerId], references: [id])
  fulfillments  ProductAllocationFulfillment[]

  @@unique([allocationId, customerId])
  @@index([customerId])
}

model ProductAllocationFulfillment {
  id               String                @id @default(auto()) @map("_id") @db.ObjectId
  allocationLineId String                @db.ObjectId
  billDate         DateTime
  billQty          Int
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  line             ProductAllocationLine @relation(fields: [allocationLineId], references: [id], onDelete: Cascade)

  @@index([allocationLineId])
}

model PurchaseInvoiceItem {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  purchaseInvoiceId  String          @db.ObjectId
  productId          String          @db.ObjectId
  /// Snapshotted at purchase create/update/sync from Product master.
  mrp                Int?
  gstPercentage      Float?
  packetsPerCarton   Int?
  costPricePerPacket Float?
  costPricePerCarton Float?
  palletQuantity     Int
  quantity           Int
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  PurchaseInvoice    PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  product            Product         @relation(fields: [productId], references: [id])

  @@index([purchaseInvoiceId])
  @@index([productId])
}

